#!/usr/bin/env bash
# callme — call/text your human's phone from an AI session. bash + curl only.
set -euo pipefail
umask 077   # session tokens and the paired number are credentials

API="${AIPHONE_API:-https://serdaroztetik.com/aiphone}"
CONF_DIR="${AIPHONE_HOME:-${AIPHONE_STATE_DIR:-$HOME/.aiphone}}"
CONF="$CONF_DIR/session.json"
USER_CONF="$CONF_DIR/config.json"

usage() {
  cat <<'EOF'
callme — your AI can call its human

  callme setup                   what to tell a human who hasn't set up the app
  callme qr [--big|--mono]       App Store QR code to scan with the phone camera
  callme pair <number>           remember the number AND ring the phone to prove it
  callme number                  show the paired number
  callme remind [on|off|status]  remind EVERY session to reach out before it ends
                                  a turn on an open question (for AFK humans)
  callme call "text"             RING the phone, speak the text, BLOCK until the
                                  spoken answer comes back (prints transcript)
  callme text "text"             send a text (push notification on the phone)
  callme listen                  long-poll; EXITS when an event arrives (voicemail,
                                  text, missed call). Run with run_in_background.
  callme events                  print any pending events without waiting
  callme title "text"            rename this session's thread on the phone
  callme whoami                  show this session's number/label
  callme register [label]        get a session number+token (usually automatic)
  callme status                  server health

  call/text take an explicit recipient too: callme call <number> "text"
  env: AIPHONE_TIMEOUT (call wait, default 300s), CALLME_USER_NUMBER (override)
EOF
  exit 1
}

need_jq() { command -v jq >/dev/null || { echo "callme needs jq (brew install jq)" >&2; exit 2; }; }

conf() { jq -r ".$1" "$CONF"; }

# --- the paired human's number: one home, ~/.aiphone/config.json ------------

norm() { printf '%s' "${1:-}" | tr -cd '0-9'; }
valid_number() { [ "${#1}" -eq 10 ]; }

display() {  # 584-158-6160, the grouping the iPhone app shows
  local n; n=$(norm "${1:-}")
  if valid_number "$n"; then printf '%s-%s-%s' "${n:0:3}" "${n:3:3}" "${n:6:4}"; else printf '%s' "$n"; fi
}

resolve_number() {
  local n
  n=$(norm "${CALLME_USER_NUMBER:-}");            valid_number "$n" && { printf '%s' "$n"; return; }
  if [ -f "$USER_CONF" ] && command -v jq >/dev/null; then
    n=$(norm "$(jq -r '.user_number // ""' "$USER_CONF" 2>/dev/null)")
    valid_number "$n" && { printf '%s' "$n"; return; }
  fi
  n=$(norm "${AIPHONE_USER_NUMBER:-}");           valid_number "$n" && { printf '%s' "$n"; return; }
  printf ''
}

require_number() {
  local n; n=$(resolve_number)
  if ! valid_number "$n"; then
    cat >&2 <<'EOF'
callme: no phone paired yet.

If they don't have the app yet, show them this — camera at the code:
EOF
    echo >&2
    do_qr >&2
    cat >&2 <<'EOF'

Then: open it, tap Agree & Continue, read back the 10-digit number, and run
  callme pair <number>

Never guess a number — it is a credential, and a wrong one rings a stranger.
EOF
    exit 5
  fi
  printf '%s' "$n"
}

do_pair() {
  need_jq
  local n; n=$(norm "${1:-}")
  valid_number "$n" || { echo "callme pair needs the 10-digit number from the app (got '${1:-}')" >&2; exit 6; }
  mkdir -p "$CONF_DIR"; chmod 700 "$CONF_DIR" 2>/dev/null || true
  local prev='{}'; [ -f "$USER_CONF" ] && prev=$(cat "$USER_CONF")
  printf '%s' "$prev" | jq --arg n "$n" --arg d "$(display "$n")" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '. + {version:1, user_number:$n, display:$d, source:"cli-pair", updated_at:$t} | del(.api)' \
    > "$USER_CONF.tmp" && mv "$USER_CONF.tmp" "$USER_CONF"
  chmod 600 "$USER_CONF"
  echo "paired with $(display "$n") (stored in $USER_CONF)"

  # Ring, don't text. A voice answer proves the entire loop in one shot — push
  # delivery, CallKit, audio both ways, transcription — and it is the moment the
  # product sells itself. The text is only the fallback.
  echo "ringing your phone now — answer it and say anything back"
  local rc=0
  # do_call `exit`s on no-answer, which under `set -e` would kill this script:
  # run it in a subshell so we can catch the code and fall back. Uncaptured, so
  # the transcript streams live.
  (
    AIPHONE_TIMEOUT="${AIPHONE_PAIR_TIMEOUT:-90}"
    do_call "$n" "You're paired with your AI assistant. Say anything back so I know I can hear you."
  ) || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "pairing confirmed by voice — I can ring you, and you can answer."
    return 0
  fi

  # No answer, or the call failed outright. Never redial — a declined call means stop.
  local why
  if why=$(do_text "$n" "Paired ✅ — this AI session can now text and call you." 2>&1); then
    echo "sent a confirmation text instead. Ask whether it arrived; if it didn't, the"
    echo "number is wrong — re-pair with the right one rather than retrying."
    return 0
  fi
  echo "callme pair: stored $(display "$n"), but NOTHING reached the phone — neither the" >&2
  echo "call nor a text:" >&2
  echo "  ${why:-no detail from the server}" >&2
  echo "Either the number is wrong (ask them to read it off the app home screen again)" >&2
  echo "or Call Me notifications are off on that phone. Do not report setup as finished." >&2
  exit 7
}

do_unpair() {
  rm -f "$USER_CONF"
  echo "unpaired (removed $USER_CONF)"
}

# Standing reminder: on Claude Code the plugin's Stop hook normally only nudges
# sessions that already used Call Me. A human who is usually away wants the
# nudge in EVERY session, including ones that would never mention Call Me.
do_remind() {
  need_jq
  case "${1:-status}" in
    status)
      if [ -f "$USER_CONF" ] && [ "$(jq -r '.always_remind // false' "$USER_CONF")" = "true" ]; then
        echo "on — every session is reminded before it ends a turn on an open question"
      else
        echo "off — only sessions that use Call Me are reminded (default)"
      fi
      ;;
    on|off)
      [ -f "$USER_CONF" ] || { echo "pair a phone first: callme pair <number>" >&2; exit 6; }
      local want=false; [ "$1" = "on" ] && want=true
      jq --argjson v "$want" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '. + {always_remind:$v, updated_at:$t}' "$USER_CONF" \
        > "$USER_CONF.tmp" && mv "$USER_CONF.tmp" "$USER_CONF"
      chmod 600 "$USER_CONF"
      do_remind status
      ;;
    *) echo "usage: callme remind [on|off|status]" >&2; exit 1;;
  esac
}

do_number() {
  local n; n=$(require_number)
  if [ "${1:-}" = "--raw" ]; then printf '%s\n' "$n"; else display "$n"; echo; fi
}

