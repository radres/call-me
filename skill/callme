do_qr() {
  local big=0 color=1
  for a in "$@"; do
    case "$a" in
      --big) big=1;;
      --mono) color=0;;
    esac
  done
  # Always draw the code — half-block glyphs survive a pipe just fine, and the
  # main caller is an agent whose stdout is never a tty. Only drop the colours.
  if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ] || [ "${TERM:-}" = "dumb" ]; then
    color=0
  fi
  awk -v big="$big" -v color="$color" '
    { rows[NR] = $0 } END {
      for (y = 1; y <= NR; y += 2) {
        top = rows[y]; bot = (y + 1 <= NR) ? rows[y + 1] : ""
        line = ""
        for (x = 1; x <= length(top); x++) {
          t = substr(top, x, 1); b = (x <= length(bot)) ? substr(bot, x, 1) : "0"
          if (t == "1") g = (b == "1") ? "\342\226\210" : "\342\226\200"
          else          g = (b == "1") ? "\342\226\204" : " "
          line = line g; if (big == 1) line = line g
        }
        if (color == 1) printf "\033[38;5;16m\033[48;5;231m%s\033[0m\n", line
        else print line
      }
    }' <<< "$QR_MATRIX"
  echo "$APPSTORE_URL"
}

do_setup() {
  local n; n=$(resolve_number)
  # The CLI is the fallback door, not the good one. If this machine has Claude
  # Code, an agent that got here by copying this script took a wrong turn — say
  # so at the exact moment it is looking, because it will not go back and reread
  # a README. (An agent CAN install the plugin itself; slash commands are only
  # for a human typing.)
  if command -v claude >/dev/null 2>&1; then
    cat <<'EOF'
--- FOR YOU, THE AGENT: this machine has Claude Code, so install the PLUGIN ---

This CLI works, but on a Claude Code host it is the lesser door: the plugin also
gives you call/text/reply tools, delivers their phone replies back into a live
session, and installs a Stop hook that catches you ending a turn on a question.
You can install it yourself, right now, with Bash — no slash commands needed:

    claude plugin marketplace add radres/call-me
    claude plugin install call-me@call-me
    claude plugin enable call-me@call-me   # REQUIRED — install leaves it DISABLED
    claude plugin list                     # expect: call-me@call-me   ✔ enabled

Do not drop the enable line. `install` writes "call-me@call-me": false into
settings.json; a disabled plugin exposes NO tools, so skipping it looks like a
clean install that then silently never works.

Then tell them to RESTART Claude Code (not /reload-plugins — that command is not
yours to run, and the monitor needs a fresh session). Keep using this CLI in the
meantime; pairing carries over, it is the same ~/.aiphone/config.json.

EOF
  fi
  cat <<EOF
Show this to your human — it's how they get set up (takes a minute):

1. Install "Call Me" on their iPhone — point the camera at this:
EOF
  echo
  do_qr "$@"
  cat <<EOF

2. Open the app, tap Agree & Continue — it shows a 10-digit number.
3. They read the number back to you.
4. Tell them their phone is about to ring, then run:  callme pair <that number>
   Pairing RINGS the phone and waits for them to speak — that answer is the
   proof the whole loop works. If nobody picks up it falls back to a text.

Then \`callme text "hi"\` lands on their phone and \`callme call "question"\`
rings it and returns what they say.

--- FOR YOU, THE AGENT: finish the job, don't stop at pairing ---

Pairing only makes you ABLE to reach them. These steps make you actually DO it,
in future sessions, without them asking again. Do all of it now:

A. Ask them one question: "How often are you away from the keyboard while I
   work — rarely, sometimes, or usually?" Their answer sets the next step.

B. If they said sometimes or usually, turn on the standing reminder:
       callme remind on
   Without this, the Claude Code Stop hook only nudges sessions that already
   used Call Me — so a session that never thinks to mention it stays silent,
   which is exactly the session where they miss you asking.

C. Write a standing rule into their user-level instructions
   (~/.claude/CLAUDE.md, or AGENTS.md for other agents). Read the file first
   and append to it — never overwrite. Use their answer from A:

       ## Reaching me
       I'm reachable on my phone through Call Me. When you need a decision, an
       answer, or input from me, contact me instead of stopping with the
       question in your final message — once your turn ends you are asleep and
       cannot reach me. That includes parking it in an interactive question
       widget: that just waits silently on a screen I'm not looking at, and no
       hook can see it, so reach out yourself.
       Text first (callme text / the text tool); call when it is blocking or
       time-sensitive. Never hardcode my number — 'callme number' reads it.
       [rarely]    I'm usually at the keyboard, so only reach out if I'll be gone a while.
       [sometimes] I'm away maybe half the time. Text me and keep working.
       [usually]   I'm mostly AFK. Assume I won't see the terminal: always reach out.

D. Verify it end to end, don't assume. If the pairing call was answered, this is
   already done — the transcript IS the proof. Only if it went unanswered:
       callme text "Setup done — this is what a message from your agent looks like."
   Ask them whether it arrived. If it did not, the number is wrong: re-pair.

E. Tell them the two things they can change later: 'callme remind off' to stop
   the every-session nudge, and blocking a thread in the app to mute it.
EOF
  if valid_number "$n"; then
    echo
    echo "(already paired with $(display "$n") — pair again only to change phones)"
    printf '(standing reminder is currently '
    do_remind status
    echo ")"
  fi
}

# --- session (this AI's own number/thread) ----------------------------------

ensure_session() {
  [ -f "$CONF" ] && return
  register "${AIPHONE_LABEL:-$(basename "$PWD") on $(hostname -s)}"
}

register() {
  need_jq
  mkdir -p "$CONF_DIR"; chmod 700 "$CONF_DIR" 2>/dev/null || true
  local label="${1:-AI session}"
  local resp
  resp=$(curl -sfS -X POST "$API/sessions" -H 'content-type: application/json' \
    -d "$(jq -cn --arg l "$label" '{label:$l}')")
  echo "$resp" | jq --arg api "$API" '. + {api:$api, cursor:0}' > "$CONF"
  chmod 600 "$CONF"
  echo "registered: $(echo "$resp" | jq -r .display) (label: $label)"
  echo "token stored in $CONF"
}

do_call() {
  need_jq; ensure_session
  local to text
  if [ $# -ge 2 ]; then to=$(norm "$1"); text="$2"; else to=$(require_number); text="${1:-}"; fi
  valid_number "$to" || { echo "callme call: bad recipient '$1'" >&2; exit 6; }
  [ -n "$text" ] || usage
  local timeout="${AIPHONE_TIMEOUT:-300}"
  local body
  body=$(jq -cn --arg t "$(conf session_token)" --arg to "$to" --arg x "$text" \
    --argjson w "$timeout" '{session_token:$t, to:$to, text:$x, timeout_s:$w}')
  # +30s curl budget over the server-side timeout
  local resp
  resp=$(curl -sS --max-time "$((timeout + 30))" -X POST "$API/calls" \
    -H 'content-type: application/json' -d "$body")
  local status
  status=$(echo "$resp" | jq -r '.status // "error"')
  case "$status" in
    completed)
      echo "ANSWER: $(echo "$resp" | jq -r .transcript)";;
    missed|declined|timeout)
      echo "NO ANSWER ($status) — consider 'callme text' instead" >&2; exit 3;;
    *)
      echo "call failed: $resp" >&2; exit 4;;
  esac
}

do_text() {
  need_jq; ensure_session
  local to text
  if [ $# -ge 2 ]; then to=$(norm "$1"); text="$2"; else to=$(require_number); text="${1:-}"; fi
  valid_number "$to" || { echo "callme text: bad recipient '$1'" >&2; exit 6; }
  [ -n "$text" ] || usage
  local resp
  resp=$(curl -sfS -X POST "$API/messages" -H 'content-type: application/json' \
    -d "$(jq -cn --arg t "$(conf session_token)" --arg to "$to" --arg b "$text" \
      '{session_token:$t, to:$to, body:$b}')")
  # A 2xx only means the server stored it. A phone with notifications off shows
  # nothing, so "sent" alone would be a lie — say so and exit non-zero, which is
  # what callers (pair's fallback) branch on. Older servers omit `delivered`.
  if [ "$(echo "$resp" | jq -r '.delivered // true')" = "false" ]; then
    echo "sent, but NOT shown on their phone: $(echo "$resp" | jq -r '.notice // ""')" >&2
    return 7
  fi
  echo "sent"
}

fetch_events() { # $1=wait seconds
  local cursor resp
  cursor=$(conf cursor)
  resp=$(curl -sfS --max-time "$(( $1 + 10 ))" -G "$API/sessions/events" \
    --data-urlencode "session_token=$(conf session_token)" \
    --data-urlencode "cursor=$cursor" --data-urlencode "wait=$1")
  local new_cursor
  new_cursor=$(echo "$resp" | jq -r .cursor)
  jq --argjson c "$new_cursor" '.cursor = $c' "$CONF" > "$CONF.tmp" \
    && mv "$CONF.tmp" "$CONF" && chmod 600 "$CONF"
  echo "$resp" | jq -c '.events[]'
}

do_title() {
  need_jq; ensure_session
  curl -sfS -X POST "$API/sessions/label" -H 'content-type: application/json' \
    -d "$(jq -cn --arg t "$(conf session_token)" --arg l "$1" \
      '{session_token:$t, label:$l}')" > /dev/null
  echo "titled: $1"
}

do_listen() {
  need_jq; ensure_session
  echo "listening as $(conf display) — waiting for an event..." >&2
  while true; do
    local out
    out=$(fetch_events 50)
    if [ -n "$out" ]; then
      echo "$out" | jq -r '"[\(.type)] \(.payload | tostring)"'
      exit 0   # exit on first event → background-task notification fires
    fi
  done
}

do_events() {
  need_jq; ensure_session
  fetch_events 0 | jq -r '"[\(.type)] \(.payload | tostring)"'
}

do_prune() { # drop per-session state files older than 30 days
  local n=0
  for f in "$CONF_DIR"/claude-session-*.json "$CONF_DIR"/claude-monitor-*.json \
           "$CONF_DIR"/claude-channel-*.json; do
    [ -f "$f" ] || continue
    if [ -z "$(find "$f" -mtime -30 2>/dev/null)" ]; then rm -f "$f"; n=$((n+1)); fi
  done
  chmod 700 "$CONF_DIR" 2>/dev/null || true
  chmod 600 "$CONF_DIR"/*.json 2>/dev/null || true
  echo "pruned $n stale state file(s)"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  setup)    do_setup;;
  qr)       do_qr "$@";;
  pair)     [ $# -ge 1 ] || usage; do_pair "$1";;
  unpair)   do_unpair;;
  remind)   do_remind "${1:-status}";;
  number)   do_number "${1:-}";;
  register) register "${1:-AI session}";;
  call)     [ $# -ge 1 ] || usage; do_call "$@";;
  text)     [ $# -ge 1 ] || usage; do_text "$@";;
  listen)   do_listen;;
  events)   do_events;;
  title)    [ $# -ge 1 ] || usage; do_title "$1";;
  whoami)   need_jq; ensure_session; jq '{session_number, display, api}' "$CONF";;
  status)   curl -sfS "$API/healthz"; echo;;
  prune)    do_prune;;
  *)        usage;;
esac
