#!/usr/bin/env bash
# callme — call/text your human's phone from an AI session. bash + curl only.
set -euo pipefail
umask 077   # session tokens and the paired number are credentials

API="${AIPHONE_API:-https://serdaroztetik.com/aiphone}"
CONF_DIR="${AIPHONE_HOME:-${AIPHONE_STATE_DIR:-$HOME/.aiphone}}"
CONF="$CONF_DIR/session.json"
USER_CONF="$CONF_DIR/config.json"

usage() {
  cat <<'EOF'
callme — your AI can call its human

  callme setup                   what to tell a human who hasn't set up the app
  callme qr [--big|--mono]       App Store QR code to scan with the phone camera
  callme pair <number>           remember the human's 10-digit Call Me number
  callme number                  show the paired number
  callme call "text"             RING the phone, speak the text, BLOCK until the
                                  spoken answer comes back (prints transcript)
  callme text "text"             send a text (push notification on the phone)
  callme listen                  long-poll; EXITS when an event arrives (voicemail,
                                  text, missed call). Run with run_in_background.
  callme events                  print any pending events without waiting
  callme title "text"            rename this session's thread on the phone
  callme whoami                  show this session's number/label
  callme register [label]        get a session number+token (usually automatic)
  callme status                  server health

  call/text take an explicit recipient too: callme call <number> "text"
  env: AIPHONE_TIMEOUT (call wait, default 300s), CALLME_USER_NUMBER (override)
EOF
  exit 1
}

need_jq() { command -v jq >/dev/null || { echo "callme needs jq (brew install jq)" >&2; exit 2; }; }

conf() { jq -r ".$1" "$CONF"; }

# --- the paired human's number: one home, ~/.aiphone/config.json ------------

norm() { printf '%s' "${1:-}" | tr -cd '0-9'; }
valid_number() { [ "${#1}" -eq 10 ]; }

display() {  # 584-158-6160, the grouping the iPhone app shows
  local n; n=$(norm "${1:-}")
  if valid_number "$n"; then printf '%s-%s-%s' "${n:0:3}" "${n:3:3}" "${n:6:4}"; else printf '%s' "$n"; fi
}

resolve_number() {
  local n
  n=$(norm "${CALLME_USER_NUMBER:-}");            valid_number "$n" && { printf '%s' "$n"; return; }
  if [ -f "$USER_CONF" ] && command -v jq >/dev/null; then
    n=$(norm "$(jq -r '.user_number // ""' "$USER_CONF" 2>/dev/null)")
    valid_number "$n" && { printf '%s' "$n"; return; }
  fi
  n=$(norm "${AIPHONE_USER_NUMBER:-}");           valid_number "$n" && { printf '%s' "$n"; return; }
  printf ''
}

require_number() {
  local n; n=$(resolve_number)
  if ! valid_number "$n"; then
    cat >&2 <<'EOF'
callme: no phone paired yet.

If they don't have the app yet, show them this — camera at the code:
EOF
    echo >&2
    do_qr >&2
    cat >&2 <<'EOF'

Then: open it, tap Agree & Continue, read back the 10-digit number, and run
  callme pair <number>

Never guess a number — it is a credential, and a wrong one rings a stranger.
EOF
    exit 5
  fi
  printf '%s' "$n"
}

do_pair() {
  need_jq
  local n; n=$(norm "${1:-}")
  valid_number "$n" || { echo "callme pair needs the 10-digit number from the app (got '${1:-}')" >&2; exit 6; }
  mkdir -p "$CONF_DIR"; chmod 700 "$CONF_DIR" 2>/dev/null || true
  local prev='{}'; [ -f "$USER_CONF" ] && prev=$(cat "$USER_CONF")
  printf '%s' "$prev" | jq --arg n "$n" --arg d "$(display "$n")" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '. + {version:1, user_number:$n, display:$d, source:"cli-pair", updated_at:$t} | del(.api)' \
    > "$USER_CONF.tmp" && mv "$USER_CONF.tmp" "$USER_CONF"
  chmod 600 "$USER_CONF"
  echo "paired with $(display "$n") (stored in $USER_CONF)"
  if do_text "$n" "Paired ✅ — this AI session can now text and call you." >/dev/null 2>&1; then
    echo "sent a confirmation text; if it didn't arrive, the number is wrong"
  else
    echo "note: confirmation text failed — double-check the number" >&2
  fi
}

do_unpair() {
  rm -f "$USER_CONF"
  echo "unpaired (removed $USER_CONF)"
}

do_number() {
  local n; n=$(require_number)
  if [ "${1:-}" = "--raw" ]; then printf '%s\n' "$n"; else display "$n"; echo; fi
}

# --- App Store onboarding ---------------------------------------------------

