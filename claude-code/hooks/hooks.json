{
  "description": "Wakes Claude when the paired human texts or leaves a voice message from the /call-me app (a background listener that runs while the session is idle), and when a turn ends on a question the human has not answered, starts a grace period that can wake Claude to text or call them. The hooks never dial; the model does.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-reachability.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/listener/listen.mjs\"",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/answer-seen.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/answer-seen.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/listener/listen.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/listener/listen.mjs\"",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
