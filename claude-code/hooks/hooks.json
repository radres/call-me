{
  "description": "Ring the paired phone when a Claude Code session is blocked waiting for input or a permission prompt.",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/blocked-notify.sh\""
          }
        ]
      }
    ]
  }
}
