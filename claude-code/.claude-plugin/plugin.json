{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "call-me",
  "displayName": "/call-me",
  "version": "0.10.1",
  "description": "Call, text, and receive replies from the /call-me app (iPhone or Android). Pair once (any session) and every Claude on this machine reaches the same phone.",
  "author": {
    "name": "Serdar Oztetik",
    "email": "serdaroztetik@gmail.com"
  },
  "homepage": "https://callmemcp.com/",
  "repository": "https://github.com/radres/call-me",
  "icon": "./.claude-plugin/icon.png",
  "documentationUrl": "https://github.com/radres/call-me#readme",
  "supportUrl": "https://github.com/radres/call-me/issues",
  "privacyPolicyUrl": "https://callmemcp.com/privacy",
  "termsOfServiceUrl": "https://callmemcp.com/terms",
  "license": "MIT",
  "keywords": [
    "phone",
    "call",
    "text",
    "sms",
    "iphone",
    "voice",
    "notifications",
    "human-in-the-loop",
    "approval"
  ],
  "defaultEnabled": false,
  "mcpServers": "./.mcp.json",
  "channels": [
    {
      "server": "callme",
      "displayName": "/call-me"
    }
  ],
  "experimental": {
    "monitors": "./monitors/monitors.json"
  },
  "userConfig": {
    "user_number": {
      "type": "string",
      "title": "Your /call-me number (optional)",
      "description": "The 10-digit number shown in the /call-me app. Leave blank and ask Claude to set up /call-me — it will walk you through it and remember the number in ~/.aiphone/config.json.",
      "required": false
    }
  }
}
